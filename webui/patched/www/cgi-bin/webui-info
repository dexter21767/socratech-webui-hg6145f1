#!/bin/sh
# webui-info - WebUI Options page: about Socratech WebUI.
# Read-only: release info (from _about.conf), device details, a live summary
# of the other WebUI Options, and credits. Status checks mirror the logic of
# the pages they describe.

export PATH=/fhrom/bin:/fhrom/fhshell:/bin:/sbin:/usr/bin:/usr/sbin:$PATH
export LD_LIBRARY_PATH=/fhrom/lib:/lib:/usr/lib:$LD_LIBRARY_PATH

# translations (WebUI Options pages share _i18n.sh)
i18n_head() { :; }
I18N="${CGI_DIR:-/www/cgi-bin}/_i18n.sh"; [ -f "$I18N" ] && . "$I18N"

NAME="Socratech WebUI"; VERSION="?"; BUILD_DATE=""; GITHUB_URL=""; FACEBOOK_URL=""; TELEGRAM_URL=""
ABOUT="${CGI_DIR:-/www/cgi-bin}/_about.conf"; [ -f "$ABOUT" ] && . "$ABOUT"

getv() { cfg_cmd get "$1" 2>/dev/null | sed -n 's/.*success!value=//p' | head -1; }
esc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'; }

# ---- login gate ----
LOGIN=$(/www/cgi-bin/is_logined.cgi 2>/dev/null | sed -n 's/.*"result":"\([0-9]\)".*/\1/p' | head -1)
if [ "$LOGIN" = "0" ]; then
	echo "Content-type: text/html"; echo ""
	echo "<html><head><meta charset='UTF-8'>$(i18n_head)</head><body style='font-family:sans-serif;padding:30px'><h3 data-i18n='login_first'>Please log in to the router UI first.</h3></body></html>"
	exit 0
fi

# ---- device ----
MODEL=$(getv InternetGatewayDevice.DeviceInfo.ModelName); [ -n "$MODEL" ] || MODEL="HG6145F1"
SWVER=$(getv InternetGatewayDevice.DeviceInfo.SoftwareVersion); [ -n "$SWVER" ] || SWVER="—"
HWVER=$(getv InternetGatewayDevice.DeviceInfo.HardwareVersion); [ -n "$HWVER" ] || HWVER="—"
UP=$(cut -d. -f1 /proc/uptime 2>/dev/null); [ -n "$UP" ] || UP=0
UP_D=$((UP / 86400)); UP_H=$((UP % 86400 / 3600)); UP_M=$((UP % 3600 / 60))

# ---- option status (same checks as the pages themselves) ----
# one table row: label key, label, status key, status text, optional arg
row() {
	echo "<tr><th data-i18n='$1'>$2</th><td><span class='dot $6'></span><span data-i18n='$3' data-arg='$(esc "$5")'>$4</span></td></tr>"
}

if [ -f /var/voip-switch.state ]; then
	read VOIP_IP _rest < /var/voip-switch.state
	VOIP_ROW=$(row opt_voip_switch "VoIP Line / Softphone" info_voip_lan "LAN softphone ($VOIP_IP)" "$VOIP_IP" on)
else
	VOIP_ROW=$(row opt_voip_switch "VoIP Line / Softphone" info_voip_rj11 "RJ11 handset" "" off)
fi

SSH_RUN=""; [ -f /var/run/ssh-access.pid ] && kill -0 "$(cat /var/run/ssh-access.pid 2>/dev/null)" 2>/dev/null && SSH_RUN=1
[ -n "$SSH_RUN" ] && SSH_ROW=$(row opt_ssh_access "SSH Access" info_on "on" "" on) \
	|| SSH_ROW=$(row opt_ssh_access "SSH Access" info_off "off" "" off)

[ "$(getv InternetGatewayDevice.X_FH_FiLink.X_FH_link_enable)" = "0" ] \
	&& TR_ROW=$(row opt_disable_tr069 "Disable TR069" info_tr_applied "patch applied" "" on) \
	|| TR_ROW=$(row opt_disable_tr069 "Disable TR069" info_tr_not "not applied" "" off)

if [ "$(getv InternetGatewayDevice.RebootTimer.X_FH_Enable)" = "1" ]; then
	SR_AT="$(getv InternetGatewayDevice.RebootTimer.X_FH_Hour_Time):$(getv InternetGatewayDevice.RebootTimer.X_FH_Minute_Time)"
	SR_ROW=$(row opt_schedule_reboot "Schedule Reboot" info_sr_on "on, at $SR_AT" "$SR_AT" on)
else
	SR_ROW=$(row opt_schedule_reboot "Schedule Reboot" info_off "off" "" off)
fi

grep -Fxq "@reboot /fhconf/custom-webui" /fhconf/crontab_conf 2>/dev/null \
	&& PE_ROW=$(row opt_persistence "Custom WebUI persistence" info_on "on" "" on) \
	|| PE_ROW=$(row opt_persistence "Custom WebUI persistence" info_off "off" "" off)

UPD=""
if [ -n "$GITHUB_URL" ]; then
	GH="<a href='$(esc "$GITHUB_URL")' target='_blank'>$(esc "$NAME")</a>"
	# manual update check: the browser asks GitHub for the latest release
	UPD="<button type='button' id='upd_btn' class='upd-btn' data-version='$(esc "$VERSION")' data-repo='$(esc "$GITHUB_URL")' data-i18n='info_check_btn'>Check for updates</button>
			<div class='upd-res' style='display:none'><span id='upd_msg'></span> <a id='upd_link' href='#' target='_blank' style='display:none' data-i18n='info_view_release'>View release</a></div>"
else
	GH="<span class='muted' data-i18n='info_gh_none'>not published yet</span>"
fi
[ -n "$BUILD_DATE" ] || BUILD_DATE="—"
COMMUNITY=""
[ -n "$FACEBOOK_URL" ] && COMMUNITY="<a href='$(esc "$FACEBOOK_URL")' target='_blank'>Facebook</a>"
[ -n "$TELEGRAM_URL" ] && COMMUNITY="${COMMUNITY:+$COMMUNITY &middot; }<a href='$(esc "$TELEGRAM_URL")' target='_blank'>Telegram</a>"
[ -n "$COMMUNITY" ] && COMMUNITY="<tr><th data-i18n='info_community'>Community</th><td>$COMMUNITY</td></tr>"

echo "Content-type: text/html"
echo ""
cat <<EOF
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title data-i18n="opt_info">Info</title>
$(i18n_head)
<style>
	body { font-family: sans-serif; background:#f1f5f9; color:#0f172a; margin:0; }
	.container { max-width:560px; margin:30px auto; background:#fff; padding:24px; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.08); }
	h2 { text-align:center; margin:0; color:#00a335; }
	h3 { font-size:15px; margin:18px 0 6px; border-bottom:1px solid #e2e8f0; padding-bottom:4px; }
	table { width:100%; border-collapse:collapse; font-size:14px; }
	th { text-align:start; font-weight:normal; color:#475569; width:45%; padding:6px 0; vertical-align:top; }
	td { padding:6px 0; }
	.ver { font-weight:bold; margin-inline-end:10px; }
	.dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-inline-end:6px; background:#cbd5e1; }
	.dot.on { background:#16a34a; }
	.muted { color:#94a3b8; }
	.upd-btn { background:#fff; color:#00a335; border:1px solid #00a335; padding:2px 10px; border-radius:12px; cursor:pointer; font-size:12px; }
	.upd-btn:hover { background:#00a335; color:#fff; }
	.upd-btn[disabled] { opacity:0.6; cursor:default; background:#fff; color:#00a335; }
	.upd-res { font-size:13px; margin-top:4px; }
	.upd-ok { color:#166534; } .upd-new { color:#b45309; font-weight:bold; } .upd-err { color:#b91c1c; }
	a { color:#2563eb; }
	.credits { margin-top:22px; padding-top:12px; border-top:1px solid #e2e8f0; font-size:13px; color:#475569; }
	.credits ul { margin:6px 0 0; padding-inline-start:18px; }
	.credits li { margin-bottom:4px; }
</style>
</head>
<body>
<div class="container">
	<h2>$(esc "$NAME")</h2>

	<h3 data-i18n="info_about">About</h3>
	<table>
		<tr><th data-i18n="info_version_lbl">Version</th><td><span class="ver">$(esc "$VERSION")</span>$UPD</td></tr>
		<tr><th data-i18n="info_build_date">Build date</th><td>$(esc "$BUILD_DATE")</td></tr>
		<tr><th>GitHub</th><td>$GH</td></tr>
		$COMMUNITY
	</table>

	<h3 data-i18n="info_device">Device</h3>
	<table>
		<tr><th data-i18n="info_model">Model</th><td>$(esc "$MODEL")</td></tr>
		<tr><th data-i18n="info_sw">Firmware</th><td>$(esc "$SWVER")</td></tr>
		<tr><th data-i18n="info_hw">Hardware</th><td>$(esc "$HWVER")</td></tr>
		<tr><th data-i18n="info_uptime">Uptime</th><td data-i18n="info_uptime_fmt" data-arg="$UP_D" data-arg1="$UP_H" data-arg2="$UP_M">${UP_D} d ${UP_H} h ${UP_M} min</td></tr>
	</table>

	<h3 data-i18n="info_options">WebUI Options</h3>
	<table>
		$VOIP_ROW
		$SSH_ROW
		$TR_ROW
		$SR_ROW
		$PE_ROW
	</table>

	<div class="credits">
		<b data-i18n="info_credits">Credits</b>
		<ul>
			<li><a href="https://github.com/numberonedz" target="_blank">numberonedz</a> &mdash; <span data-i18n="info_credit_numberonedz">original custom WebUI and reboot persistence</span></li>
			<li><a href="https://github.com/MrSmiiith" target="_blank">MrSmiiith</a> &mdash; <span data-i18n="info_credit_mrsmiiith">SSH access</span></li>
		</ul>
		<p data-i18n="info_maintained">Maintained by the Socratech community.</p>
	</div>
</div>
<script>
// Check for updates: compare _about.conf's VERSION with GitHub's latest
// release. Values come from the button's attributes (the httpd may have
// rewritten their dots as _point_, so clean them first).
(function(){
	var btn = document.getElementById('upd_btn');
	if (!btn) return;
	var msg = document.getElementById('upd_msg'), link = document.getElementById('upd_link');
	function clean(s) { return String(s || '').replace(/_point_/g, '.'); }
	function say(key, en, arg, cls) {
		msg.className = cls || '';
		msg.parentNode.style.display = '';
		msg.setAttribute('data-i18n', key);
		if (arg != null) msg.setAttribute('data-arg', arg); else msg.removeAttribute('data-arg');
		msg.textContent = en.replace('{0}', arg == null ? '' : arg);
		window.i18nApply && window.i18nApply();
	}
	// numeric compare of x.y.z; a pre-release (1.0.0-dev.abc) is older than 1.0.0
	function cmp(a, b) {
		var pa = a.split('-'), pb = b.split('-'), x = pa[0].split('.'), y = pb[0].split('.');
		for (var i = 0; i < Math.max(x.length, y.length); i++) {
			var d = (parseInt(x[i], 10) || 0) - (parseInt(y[i], 10) || 0);
			if (d) return d > 0 ? 1 : -1;
		}
		if (pa.length !== pb.length) return pa.length > 1 ? -1 : 1;
		return 0;
	}
	btn.onclick = function() {
		var local = clean(btn.getAttribute('data-version')).replace(/^v/, '');
		var repo = clean(btn.getAttribute('data-repo')).replace(/^https?:\/\/github[.]com\//, '').replace(/\/+$/, '');
		function fail() { say('info_check_fail', 'Could not check for updates', null, 'upd-err'); btn.disabled = false; }
		link.style.display = 'none';
		btn.disabled = true;
		say('info_checking', 'Checking…');
		var x = new XMLHttpRequest();
		x.open('GET', 'https://api.github.com/repos/' + repo + '/releases/latest');
		x.setRequestHeader('Accept', 'application/vnd.github+json');
		x.timeout = 10000;
		x.onerror = x.ontimeout = fail;
		x.onload = function() {
			btn.disabled = false;
			if (x.status == 404) return say('info_no_release', 'No release published yet', null, 'muted');
			if (x.status != 200) return fail();
			try { var r = JSON.parse(x.responseText); } catch (e) { return fail(); }
			var tag = String(r.tag_name || ''), c = cmp(tag.replace(/^v/, ''), local);
			if (!tag) return fail();
			link.href = r.html_url;
			if (c > 0) { say('info_upd_avail', 'Update available: {0}', tag, 'upd-new'); link.style.display = ''; }
			else if (c == 0) say('info_uptodate', 'Up to date', null, 'upd-ok');
			else say('info_upd_ahead', 'Newer than the latest release ({0})', tag, 'muted');
		};
		x.send();
	};
})();
</script>
</body>
</html>
EOF
