#!/bin/sh

CRON_FILE="/fhconf/crontab_conf"
SHELL_HEADER="SHELL=/bin/sh"

RULE_TCP_IN='@reboot /fhrom/bin/iptables -I INPUT -p tcp --dport 7547 -j DROP'
RULE_UDP_IN='@reboot /fhrom/bin/iptables -I INPUT -p udp --dport 7547 -j DROP'
RULE_TCP_OUT='@reboot /fhrom/bin/iptables -I OUTPUT -p tcp --dport 7547 -j DROP'
RULE_UDP_OUT='@reboot /fhrom/bin/iptables -I OUTPUT -p udp --dport 7547 -j DROP'

if [ "$REQUEST_METHOD" = "POST" ]; then
    read POST_DATA
    ACTION=$(echo "$POST_DATA" | sed -n 's/^action=\(.*\)$/\1/p')
fi

[ -f "$CRON_FILE" ] || touch "$CRON_FILE"

enable_rules() {
    FIRST_LINE=$(head -n 1 "$CRON_FILE")
    if [ "$FIRST_LINE" != "$SHELL_HEADER" ]; then
        sed -i "1i $SHELL_HEADER" "$CRON_FILE"
    fi

    grep -qxF "$RULE_TCP_IN" "$CRON_FILE" || echo "$RULE_TCP_IN" >> "$CRON_FILE"
    grep -qxF "$RULE_UDP_IN" "$CRON_FILE" || echo "$RULE_UDP_IN" >> "$CRON_FILE"
    grep -qxF "$RULE_TCP_OUT" "$CRON_FILE" || echo "$RULE_TCP_OUT" >> "$CRON_FILE"
    grep -qxF "$RULE_UDP_OUT" "$CRON_FILE" || echo "$RULE_UDP_OUT" >> "$CRON_FILE"
}

disable_rules() {
    sed -i "\|$RULE_TCP_IN|d" "$CRON_FILE"
    sed -i "\|$RULE_UDP_IN|d" "$CRON_FILE"
    sed -i "\|$RULE_TCP_OUT|d" "$CRON_FILE"
    sed -i "\|$RULE_UDP_OUT|d" "$CRON_FILE"
}

check_status() {
    if grep -qxF "$RULE_TCP_IN" "$CRON_FILE" &&
       grep -qxF "$RULE_UDP_IN" "$CRON_FILE" &&
       grep -qxF "$RULE_TCP_OUT" "$CRON_FILE" &&
       grep -qxF "$RULE_UDP_OUT" "$CRON_FILE"; then
        echo "enabled"
    else
        echo "disabled"
    fi
}

case "$ACTION" in
    enable) 
		enable_rules 
        /fhrom/bin/iptables -I INPUT -p tcp --dport 7547 -j DROP
		/fhrom/bin/iptables -I INPUT -p udp --dport 7547 -j DROP
		/fhrom/bin/iptables -I OUTPUT -p tcp --dport 7547 -j DROP
		/fhrom/bin/iptables -I OUTPUT -p udp --dport 7547 -j DROP
		
		echo "Status: 302 Found"
        echo "Location: tr069-firewall"
        echo ""
        exit 0
    ;;
    disable) 
		disable_rules 
		/fhrom/bin/iptables -D INPUT -p tcp --dport 7547 -j DROP
		/fhrom/bin/iptables -D INPUT -p udp --dport 7547 -j DROP
		/fhrom/bin/iptables -D OUTPUT -p tcp --dport 7547 -j DROP
		/fhrom/bin/iptables -D OUTPUT -p udp --dport 7547 -j DROP
		
		echo "Status: 302 Found"
        echo "Location: tr069-firewall"
        echo ""
        exit 0
    ;;
esac

STATUS=$(check_status)

if [ "$STATUS" = "enabled" ]; then
    STATUS_COLOR="#16a34a"
    STATUS_BG="#dcfce7"
else
    STATUS_COLOR="#dc2626"
    STATUS_BG="#fee2e2"
fi

#CRON_CONTENT=$(cat "$CRON_FILE" 2>/dev/null)
IPTABLES_CONTENT=$(iptables -S 2>/dev/null)

echo "Content-type: text/html"
echo ""

cat <<EOF
