#!/bin/sh
# voip-switch - WebUI Options page.
# Moves the VoIP line between the RJ11 handset and ONE LAN softphone, and
# prints the SIP credentials for configuring the softphone app.
# Standalone CGI (renders its own page), modelled on the other custom tools.
# Reboot-persistence policy (same as tr069-firewall / schedule-reboot):
# LAN mode writes an @reboot hook in /fhconf that re-applies it at boot;
# RJ11 mode removes the hook.

export PATH=/fhrom/bin:/fhrom/fhshell:/bin:/sbin:/usr/bin:/usr/sbin:$PATH
export LD_LIBRARY_PATH=/fhrom/lib:/lib:/usr/lib:$LD_LIBRARY_PATH
# translations (WebUI Options pages share _i18n.sh)
i18n_head() { :; }
I18N="${CGI_DIR:-/www/cgi-bin}/_i18n.sh"; [ -f "$I18N" ] && . "$I18N"

VOIP_IF="veip0.114"
TABLE=190
PRIO=95
RTP="20000:30000"
STATE="/var/voip-switch.state"
CRON="/fhconf/crontab_conf"
BOOT="/fhconf/voip-switch.boot"
CRON_LINE="@reboot /bin/sh $BOOT"
SHELL_HDR="SHELL=/bin/sh"
B="InternetGatewayDevice.Services.VoiceService.1.VoiceProfile.1"

getv() { cfg_cmd get "$1" 2>/dev/null | sed -n 's/.*success!value=//p' | head -1; }
voip_ip() { ip -4 addr show "$VOIP_IF" 2>/dev/null | sed -n 's#.*inet \([0-9.]*\)/.*#\1#p' | head -1; }
esc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'; }
getp() { echo "$POST_DATA" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1; }
valid_ip() { echo "$1" | grep -Eq '^192\.168\.[0-9]{1,3}\.[0-9]{1,3}$'; }

# $1 = -I|-D, $2 = phone ip, $3 = voice ip
rules() {
	iptables -t nat $1 PREROUTING -i "$VOIP_IF" -p udp --dport 5060 -j DNAT --to-destination "$2:5060" 2>/dev/null
	iptables -t nat $1 PREROUTING -i "$VOIP_IF" -p udp --dport $RTP -j DNAT --to-destination "$2" 2>/dev/null
	iptables -t nat $1 POSTROUTING -s "$2" -o "$VOIP_IF" -j SNAT --to-source "$3" 2>/dev/null
	iptables $1 FORWARD -i "$VOIP_IF" -o br0 -d "$2" -j DROP 2>/dev/null
	iptables $1 FORWARD -i "$VOIP_IF" -o br0 -d "$2" -m conntrack --ctstate ESTABLISHED,RELATED,DNAT -j ACCEPT 2>/dev/null
	iptables $1 FORWARD -i br0 -o "$VOIP_IF" -s "$2" -j ACCEPT 2>/dev/null
}

# write the persistent boot re-apply hook for LAN mode ($1 = phone ip)
persist_lan() {
	PH="$1"
	cat > "$BOOT" <<BEOF
#!/bin/sh
# re-apply VoIP LAN mode after reboot (generated by voip-switch)
export PATH=/fhrom/bin:/fhrom/fhshell:/bin:/sbin:/usr/bin:/usr/sbin:\$PATH
export LD_LIBRARY_PATH=/fhrom/lib:/lib:/usr/lib:\$LD_LIBRARY_PATH
PHONE="$PH"
VOIP_IF="veip0.114"
i=0
while [ \$i -lt 90 ]; do
	VIP=\$(ip -4 addr show "\$VOIP_IF" 2>/dev/null | sed -n 's#.*inet \([0-9.]*\)/.*#\1#p' | head -1)
	[ -n "\$VIP" ] && break
	sleep 2; i=\$((i+1))
done
[ -n "\$VIP" ] || exit 0
mv /var/VOIP_RUN /var/VOIP_RUN.off 2>/dev/null
sh /fhrom/fhshell/voice_init.sh stop sip >/dev/null 2>&1
conntrack -D -p udp -s "\$VIP" >/dev/null 2>&1
conntrack -D -p udp -d "\$VIP" >/dev/null 2>&1
ip rule add from "\$PHONE" to 10.0.0.0/8 lookup 190 priority 95 2>/dev/null
iptables -t nat -I PREROUTING -i "\$VOIP_IF" -p udp --dport 5060 -j DNAT --to-destination "\$PHONE:5060"
iptables -t nat -I PREROUTING -i "\$VOIP_IF" -p udp --dport 20000:30000 -j DNAT --to-destination "\$PHONE"
iptables -t nat -I POSTROUTING -s "\$PHONE" -o "\$VOIP_IF" -j SNAT --to-source "\$VIP"
iptables -I FORWARD -i "\$VOIP_IF" -o br0 -d "\$PHONE" -j DROP
iptables -I FORWARD -i "\$VOIP_IF" -o br0 -d "\$PHONE" -m conntrack --ctstate ESTABLISHED,RELATED,DNAT -j ACCEPT
iptables -I FORWARD -i br0 -o "\$VOIP_IF" -s "\$PHONE" -j ACCEPT
ip route flush cache 2>/dev/null
echo "\$PHONE \$VIP" > /var/voip-switch.state
BEOF
	chmod +x "$BOOT"
	[ -f "$CRON" ] || touch "$CRON"
	head -n 1 "$CRON" 2>/dev/null | grep -qxF "$SHELL_HDR" || sed -i "1i $SHELL_HDR" "$CRON"
	grep -qxF "$CRON_LINE" "$CRON" || echo "$CRON_LINE" >> "$CRON"
}

persist_off() {
	[ -f "$CRON" ] && sed -i "\|$CRON_LINE|d" "$CRON"
	rm -f "$BOOT"
}

revert_quiet() {
	[ -f "$STATE" ] || return
	read P V < "$STATE"
	rules -D "$P" "$V"
	ip rule del from "$P" to 10.0.0.0/8 lookup $TABLE priority $PRIO 2>/dev/null
	conntrack -D -p udp -s "$P" >/dev/null 2>&1
	conntrack -D -p udp -d "$V" >/dev/null 2>&1
	ip route flush cache 2>/dev/null
	rm -f "$STATE"
}

apply_lan() {
	PHONE="$1"
	VIP=$(voip_ip); [ -n "$VIP" ] || { MSG="No IP on $VOIP_IF - is the voice line up?"; MKEY=vs_err_noip; MARG="$VOIP_IF"; MCLASS="err"; return; }
	revert_quiet
	mv /var/VOIP_RUN /var/VOIP_RUN.off 2>/dev/null
	sh /fhrom/fhshell/voice_init.sh stop sip >/dev/null 2>&1
	conntrack -D -p udp -s "$VIP" >/dev/null 2>&1
	conntrack -D -p udp -d "$VIP" >/dev/null 2>&1
	ip rule add from "$PHONE" to 10.0.0.0/8 lookup $TABLE priority $PRIO 2>/dev/null
	rules -I "$PHONE" "$VIP"
	ip route flush cache 2>/dev/null
	echo "$PHONE $VIP" > "$STATE"
	persist_lan "$PHONE"
	MSG="LAN mode on. $PHONE now owns the line (kept across reboots). The RJ11 handset is off."; MKEY=vs_ok_lan; MARG="$PHONE"
	MCLASS="ok"
}

apply_rj11() {
	revert_quiet
	persist_off
	mv /var/VOIP_RUN.off /var/VOIP_RUN 2>/dev/null
	sh /fhrom/fhshell/voice_init.sh start sip >/dev/null 2>&1
	MSG="RJ11 mode restored. The handset re-registers in a few seconds."; MKEY=vs_ok_rj11
	MCLASS="ok"
}

# --- login gate (best effort; proceeds if the helper is unavailable) ---
LOGIN=$(/www/cgi-bin/is_logined.cgi 2>/dev/null | sed -n 's/.*"result":"\([0-9]\)".*/\1/p' | head -1)
if [ "$LOGIN" = "0" ]; then
	echo "Content-type: text/html"; echo ""
	echo "<html><head><meta charset='UTF-8'>$(i18n_head)</head><body style='font-family:sans-serif;padding:30px'><h3 data-i18n='login_first'>Please log in to the router UI first.</h3></body></html>"
	exit 0
fi

# --- handle Apply ---
MSG=""; MCLASS=""; MKEY=""; MARG=""
if [ "$REQUEST_METHOD" = "POST" ] && [ -n "$CONTENT_LENGTH" ]; then
	read -n "$CONTENT_LENGTH" POST_DATA
	MODE=$(getp mode)
	IP=$(getp ip)
	if [ "$MODE" = "lan" ]; then
		if valid_ip "$IP"; then apply_lan "$IP"; else MSG="Enter a valid LAN IP, e.g. 192.168.2.50"; MKEY=vs_err_ip; MCLASS="err"; fi
	elif [ "$MODE" = "rj11" ]; then
		apply_rj11
	fi
fi

# --- current state ---
if [ -f "$STATE" ]; then
	read CUR_IP CUR_VIP < "$STATE"; CUR_MODE="lan"
else
	CUR_MODE="rj11"; CUR_IP=""
fi
SIP_PROC=$(pidof sip 2>/dev/null)
[ -n "$SIP_PROC" ] && { SIP_STATE="running (PID $SIP_PROC)"; SIP_KEY=vs_sip_run; } || { SIP_STATE="stopped"; SIP_KEY=vs_sip_stop; }
LINE_STATUS=$(getv "$B.Line.1.Status")
[ -z "$LINE_STATUS" ] && LINE_STATUS="unknown"
[ -f "$BOOT" ] && { PERSIST="on (re-applies at boot)"; PKEY=vs_persist_on; } || { PERSIST="off"; PKEY=persist_off; }

# --- credentials (read on the device; this is your own line) ---
NUMBER=$(getv "$B.Line.1.DirectoryNumber")
AUTHUSER=$(getv "$B.Line.1.SIP.AuthUserName")
PASSWORD=$(getv "$B.Line.1.SIP.AuthPassword")
DOMAIN=$(getv "$B.SIP.RegistrarServer")
PROXY=$(getv "$B.SIP.ProxyServer")
PROXYPORT=$(getv "$B.SIP.ProxyServerPort")
EXPIRES=$(getv "$B.SIP.RegisterExpires")
[ -z "$PROXYPORT" ] && PROXYPORT="5060"

LAN_SEL=""; RJ_SEL=""
[ "$CUR_MODE" = "lan" ] && LAN_SEL="selected" || RJ_SEL="selected"

echo "Content-type: text/html"
echo ""
cat <<EOF
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title data-i18n="vs_title">VoIP Line / Softphone</title>
$(i18n_head)
<style>
	body { font-family: sans-serif; background:#f1f5f9; color:#0f172a; margin:0; }
	.container { max-width:560px; margin:30px auto; background:#fff; padding:24px;
		border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.08); }
	h2 { text-align:center; margin-top:0; }
	.msg { padding:10px 12px; border-radius:8px; margin-bottom:16px; font-weight:bold; }
	.ok { background:#dcfce7; color:#166534; }
	.err { background:#fee2e2; color:#b91c1c; }
	label { font-weight:bold; display:block; margin:12px 0 4px; }
	select, input[type=text], input[type=password] { width:100%; padding:9px; box-sizing:border-box;
		border:1px solid #cbd5e1; border-radius:6px; font-size:14px; }
	.apply { background:#2c3e50; color:#fff; border:none; padding:11px; width:100%;
		border-radius:6px; cursor:pointer; margin-top:16px; font-size:15px; }
	.status { background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:12px; margin-bottom:16px; font-size:14px; }
	.creds { margin-top:20px; }
	.creds h3 { margin-bottom:6px; }
	.row { display:flex; gap:8px; align-items:center; margin-top:8px; }
	.row span { flex:0 0 130px; color:#475569; font-size:13px; }
	.row input { flex:1; background:#f8fafc; }
	.note { font-size:12px; color:#64748b; margin-top:8px; }
	.warn { background:#fef9c3; color:#854d0e; padding:8px 10px; border-radius:6px; font-size:13px; margin-top:8px; }
</style>
</head>
<body>
<div class="container">
	<h2 data-i18n="vs_title">VoIP Line / Softphone</h2>
EOF

[ -n "$MSG" ] && echo "<div class='msg $MCLASS' data-i18n='$MKEY' data-arg='$(esc "$MARG")'>$(esc "$MSG")</div>"

cat <<EOF
	<div class="status">
		<b data-i18n="vs_lbl_mode">Current mode:</b> $([ "$CUR_MODE" = "lan" ] && echo "<span data-i18n='vs_mode_lan' data-arg='$(esc "$CUR_IP")'>LAN softphone ($(esc "$CUR_IP"))</span>" || echo "<span data-i18n='vs_mode_rj11'>RJ11 handset</span>")<br>
		<b data-i18n="vs_lbl_sip">ONT SIP client:</b> <span data-i18n="$SIP_KEY" data-arg="$SIP_PROC">$SIP_STATE</span><br>
		<b data-i18n="vs_lbl_line">Line status:</b> <span data-i18n="line_$(esc "$LINE_STATUS")">$(esc "$LINE_STATUS")</span><br>
		<b data-i18n="lbl_persist">Persistence:</b> <span data-i18n="$PKEY">$PERSIST</span>
	</div>

	<form method="POST" id="f">
		<label for="mode" data-i18n="vs_use_from">Use the line from</label>
		<select name="mode" id="mode" onchange="toggleIp()">
			<option value="rj11" $RJ_SEL data-i18n="vs_opt_rj11">RJ11 handset (physical phone)</option>
			<option value="lan" $LAN_SEL data-i18n="vs_opt_lan">LAN softphone (app on your network)</option>
		</select>

		<div id="ipwrap">
			<label for="ip" data-i18n="vs_ip">Softphone local IP address</label>
			<input type="text" name="ip" id="ip" value="$(esc "$CUR_IP")" placeholder="192.168.2.50">
			<div class="note" data-i18n="vs_ip_note">Static LAN IP of the device running the softphone (gateway 192.168.2.1).</div>
		</div>

		<div class="warn" data-i18n="vs_warn">Switching to LAN mode takes the line from the RJ11 handset (one registration per line). Your choice is kept across reboots.</div>
		<button type="submit" class="apply" data-i18n="btn_apply">Apply</button>
	</form>

	<div class="creds">
		<h3 data-i18n="vs_creds">Softphone credentials</h3>
		<div class="row"><span data-i18n="vs_c_number">Username / number</span><input type="text" readonly value="$(esc "$NUMBER")"></div>
		<div class="row"><span data-i18n="vs_c_auth">Auth username</span><input type="text" readonly value="$(esc "$AUTHUSER")"></div>
		<div class="row"><span data-i18n="vs_c_pw">Password</span><input type="password" id="pw" readonly value="$(esc "$PASSWORD")"></div>
		<div class="row"><span></span><label style="font-weight:normal;font-size:13px;margin:0"><input type="checkbox" onclick="document.getElementById('pw').type=this.checked?'text':'password'"> <span data-i18n="vs_show_pw">Show password</span></label></div>
		<div class="row"><span data-i18n="vs_c_domain">Domain / registrar</span><input type="text" readonly value="$(esc "$DOMAIN")"></div>
		<div class="row"><span data-i18n="vs_c_proxy">Outbound proxy</span><input type="text" readonly value="$(esc "$PROXY"):$(esc "$PROXYPORT")"></div>
		<div class="row"><span data-i18n="vs_c_transport">Transport</span><input type="text" readonly value="UDP"></div>
		<div class="row"><span data-i18n="vs_c_sipport">Local SIP port</span><input type="text" readonly value="5060"></div>
		<div class="row"><span data-i18n="vs_c_rtp">RTP port range</span><input type="text" readonly value="20000-30000"></div>
		<div class="row"><span data-i18n="vs_c_expiry">Register expiry</span><input type="text" readonly value="$(esc "$EXPIRES")"></div>
		<div class="note" data-i18n="vs_stun_note" data-i18n-html><b>STUN / ICE must be OFF</b> &mdash; with STUN on, outbound calls work but incoming calls fail. Codecs: PCMA (G.711 A-law) then PCMU.</div>
	</div>
</div>

<script>
	function toggleIp() {
		document.getElementById('ipwrap').style.display =
			document.getElementById('mode').value === 'lan' ? 'block' : 'none';
	}
	toggleIp();
</script>
</body>
</html>
EOF
